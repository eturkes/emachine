+/// Preserve stock leadership for recognized input; bare CSI arrows need Send on resident 0.8.1 daemons.
+pub fn clientInputTag(payload: []const u8) ipc.Tag {
+    if (isUserInput(payload)) return .Input;
+    var parser = ghostty_vt.Parser.init();
+    defer parser.deinit();
+    for (payload) |byte| {
+        const actions = parser.next(byte);
+        for (actions) |action_opt| {
+            const action = action_opt orelse continue;
+            switch (action) {
+                .csi_dispatch => |csi| {
+                    if (csi.intermediates.len == 0 and csi.params.len == 0 and
+                        csi.final >= 'A' and csi.final <= 'D') return .Send;
+                },
+                else => {},
+            }
+        }
+    }
+    return .Input;
+}
+
+test "client arrow routing preserves bytes and ordinary input leadership" {
+    for ([_][]const u8{
+        "\x1b[A", "\x1b[B", "\x1b[C", "\x1b[D",
+        "\x1b[A\x1b[B\x1b[C\x1b[D",
+        "\x1b[1;1R\x1b[A", "\x1b[A\x1b[?1;2c",
+    }) |payload| try testing.expectEqual(ipc.Tag.Send, clientInputTag(payload));
+    for ([_][]const u8{
+        "", "a", "\x1b[Aa", "a\x1b[A", "\x1bOA",
+        "\x1b[1;5A", "\x1b[1;3D", "\x1b[1A",
+        "\r", "\t", "\x7f", "\x03", "\x1b", "\x1b[",
+        "\x1b[1;1R", "\x1b[?1;2c", "\x1b[I", "\x1b[O",
+        "\x1b[?A", "\x1b[ A", "\x1b[200~\x1b[A\x1b[201~",
+        "\x1b]0;[A\x07", "\x1bPq[A\x1b\\", "\x1b_G[A\x1b\\",
+    }) |payload| try testing.expectEqual(ipc.Tag.Input, clientInputTag(payload));
+}
