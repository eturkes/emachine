diff --git a/src/util.zig b/src/util.zig
--- a/src/util.zig
+++ b/src/util.zig
@@ -893,3 +893,98 @@
+const restore_boundary = "\x1b[2J\x1b[H\x1b[0m";
+
+/// Recognize the complete, history-bearing initial restore used by the pinned daemon.
+/// Unknown formats, incomplete streams, and application-owned synchronized updates stay untouched.
+pub fn shouldSynchronizeRestore(payload: []const u8) bool {
+    const boundary = std.mem.indexOf(u8, payload, restore_boundary) orelse return false;
+    if (boundary == 0 or !std.unicode.utf8ValidateSlice(payload)) return false;
+
+    var parser = ghostty_vt.Parser.init();
+    defer parser.deinit();
+    return !hasSynchronizedOutput(&parser, payload) and parser.state == .ground;
+}
+
+/// Track application-owned synchronization across live packets preceding Init's snapshot.
+pub fn hasSynchronizedOutput(parser: *ghostty_vt.Parser, payload: []const u8) bool {
+    for (payload) |byte| {
+        for (parser.next(byte)) |action_opt| {
+            const action = action_opt orelse continue;
+            switch (action) {
+                .csi_dispatch => |csi| {
+                    if ((csi.final == 'h' or csi.final == 'l') and
+                        std.mem.indexOfScalar(u16, csi.params, 2026) != null) return true;
+                },
+                else => {},
+            }
+        }
+    }
+    return false;
+}
+
+/// The browser may render a manual leader's observed grid rather than this client's requested PTY size.
+pub fn restoreRows(value: ?[]const u8, fallback: u16) u16 {
+    const rows = std.fmt.parseInt(u16, value orelse return fallback, 10) catch return fallback;
+    return if (rows >= 2 and rows <= 500) rows else fallback;
+}
+
+pub fn appendSynchronizedRestore(
+    alloc: std.mem.Allocator,
+    output: *std.ArrayList(u8),
+    payload: []const u8,
+    rows: u16,
+) !void {
+    const boundary = std.mem.indexOf(u8, payload, restore_boundary).?;
+    try output.appendSlice(alloc, "\x1b]1337;EmachineRestore=begin\x07\x1b[?2026h");
+    try output.appendSlice(alloc, payload[0..boundary]);
+    // ED2 erases the visible tail of phase-one history. Real CRLF scrolling first
+    // moves that tail into native scrollback; CSI S would discard it in xterm.
+    for (0..rows) |_| try output.appendSlice(alloc, "\r\n");
+    try output.appendSlice(alloc, payload[boundary..]);
+    try output.appendSlice(alloc, "\x1b[?2026l\x1b]1337;EmachineRestore=end\x07");
+}
+
+test "restore synchronization preserves application modes and complete stream boundaries" {
+    const alloc = testing.allocator;
+    const history = try alloc.alloc(u8, 8192);
+    defer alloc.free(history);
+    @memset(history, 'x');
+    const frame = try std.mem.concat(alloc, u8, &.{
+        history, restore_boundary, "screen 2026 \xc3\xa9\xe7\x95\x8c\x1b[1;1H",
+    });
+    defer alloc.free(frame);
+    try testing.expect(shouldSynchronizeRestore(frame));
+    try testing.expect(!shouldSynchronizeRestore(history));
+    try testing.expect(!shouldSynchronizeRestore("\x1b[2J\x1b[H\x1b[0mscreen"));
+    try testing.expect(shouldSynchronizeRestore("short history\x1b[2J\x1b[H\x1b[0mscreen"));
+
+    for ([_][]const u8{
+        "\x1b[?2026h", "\x1b[?2026l", "\x1b[?25;2026h", "\x1b[?2026;25l",
+        "\x1b[", "\x1b]0;unfinished", "\xc3",
+    }) |suffix| {
+        const incomplete_or_owned = try std.mem.concat(alloc, u8, &.{ frame, suffix });
+        defer alloc.free(incomplete_or_owned);
+        try testing.expect(!shouldSynchronizeRestore(incomplete_or_owned));
+    }
+    const title = try std.mem.concat(alloc, u8, &.{ frame, "\x1b]2;year 2026\x07" });
+    defer alloc.free(title);
+    try testing.expect(shouldSynchronizeRestore(title));
+}
+
+test "restore flush preserves original bytes and uses the observed screen height" {
+    const alloc = testing.allocator;
+    var output: std.ArrayList(u8) = .empty;
+    defer output.deinit(alloc);
+    try appendSynchronizedRestore(alloc, &output, "history\x1b[2J\x1b[H\x1b[0mscreen", 2);
+    try testing.expectEqualStrings(
+        "\x1b]1337;EmachineRestore=begin\x07\x1b[?2026hhistory\r\n\r\n\x1b[2J\x1b[H\x1b[0mscreen\x1b[?2026l\x1b]1337;EmachineRestore=end\x07",
+        output.items,
+    );
+    try testing.expectEqual(@as(u16, 30), restoreRows("30", 39));
+    try testing.expectEqual(@as(u16, 30), restoreRows(null, 30));
+    for ([_][]const u8{ "", "0", "1", "-1", "501", "65536", "bad" }) |value| {
+        try testing.expectEqual(@as(u16, 30), restoreRows(value, 30));
+    }
+}
