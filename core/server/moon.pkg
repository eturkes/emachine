import {
  "eturkes/emachine/model",
  "eturkes/emachine/native",
  "eturkes/emachine/features",
  "eturkes/emachine/pty",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/http",
  "moonbitlang/async/io",
  "moonbitlang/async/process",
  "moonbitlang/async/signal",
  "moonbitlang/async/socket",
  "moonbitlang/async/websocket",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "-all+native"
options(link: { "native": { "cc-link-flags": "-lcrypto" } })
